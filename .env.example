# ==========================================
# 720pier Tracker Configuration
# ==========================================
# Target THUUZ Rating Topic URL
PIER_THREAD_URL=https://720pier.ru/viewtopic.php?t=76272

# Tracker Credentials (used for automatic login)
PIER_USERNAME=
PIER_PASSWORD=

# Session Cookie Override (Optional, recommended if Cloudflare or CAPTCHA is present)
# Paste your full browser Cookie header or phpbb3_ session cookies here:
# Example: phpbb3_xbtbb_u=12345; phpbb3_xbtbb_k=abcdef; phpbb3_xbtbb_sid=0123456789
PIER_COOKIE=

# Preferred resolution if game release page has multiple torrents (e.g., 1080p, 720p).
# Leave empty to pick the first available torrent.
QUALITY_PREFERENCE=

# Favorite team(s) to always download in addition to the top 2 matches (comma-separated)
# Matches e.g. "Kansas City Chiefs", "KC", "Chiefs"
FAVORITE_TEAMS=Kansas City Chiefs, KC, Chiefs

# Optional HTTP/SOCKS5 Proxy (e.g., socks5://127.0.0.1:1080 or http://proxy:8080)
# Useful if 720pier.ru blocks your local ISP / region with 403 Forbidden
PROXY_URL=

# ==========================================
# qBittorrent Configuration
# ==========================================
# Host URL (use container name if on the same Docker network or host.docker.internal)
QBIT_HOST=http://qbittorrent:8080

# qBittorrent WebUI API Key (v5.2.0+, recommended)
# Found in qBittorrent under Preferences -> WebUI -> API Key -> Generate
QBIT_API_KEY=

# Fallback credentials (only needed if QBIT_API_KEY is not set)
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# Category and Tags to assign to downloaded torrents
QBIT_CATEGORY=NFL
QBIT_TAGS=720pier,thuuz

# Download save path on the qBittorrent server (e.g., /nfl)
QBIT_SAVE_PATH=/nfl

# Automatically start download (true/false)
QBIT_AUTO_START=true

# Automatically rename torrent and underlying file to:
# "Week 05 - Buffalo Bills at Los Angeles Rams (2026).ext"
RENAME_TORRENT_FILES=true

# ==========================================
# Service & Scheduling
# ==========================================
# Days of the week to run checks (comma-separated: Mon, Tue, Wed, Thu, Fri, Sat, Sun)
SCHEDULE_DAYS=Mon,Tue,Wed

# Polling interval in hours on scheduled active days
CHECK_INTERVAL_HOURS=6

# Path to persistent state file
STATE_FILE_PATH=data/state.json

# ==========================================
# Optional Notifications (Discord / Telegram)
# ==========================================
# Discord Webhook URL (leave empty to disable)
DISCORD_WEBHOOK_URL=

# Telegram Bot configuration (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
